{
  "name": "@raui/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node --env-file=../../.env --watch dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=../../.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .cache/test/health.test.js .cache/test/core.test.js .cache/test/search.test.js",
    "test:integration": "tsc -p tsconfig.test.json && node --env-file=../../.env scripts/integration.mjs",
    "db:migrate": "node --env-file=../../.env dist/modules/database/migrate.js",
    "worker": "node --env-file=../../.env dist/worker.js",
    "admin:bootstrap": "node --env-file=../../.env dist/modules/auth/bootstrap-admin.js",
    "smoke:core": "node --env-file=../../.env scripts/core-smoke.mjs",
    "worker:search": "node --env-file=../../.env dist/search-worker.js",
    "test:e2e": "node --env-file=../../.env scripts/product-e2e.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "express": "^5",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "redis": "^5.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "^4.1.12",
    "@raui/types": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2",
    "@types/express": "^5",
    "@types/pg": "^8.15.5"
  }
}
