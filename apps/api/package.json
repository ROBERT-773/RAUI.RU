{
  "name": "@raui/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node --env-file=../../.env --watch dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=../../.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .cache/test/health.test.js .cache/test/reset-smtp.test.js .cache/test/core.test.js .cache/test/search.test.js .cache/test/commerce.test.js .cache/test/commerce-signatures.test.js .cache/test/professional.test.js .cache/test/ai-trust.test.js .cache/test/ai-provider.test.js .cache/test/readiness.test.js .cache/test/ingress.test.js .cache/test/operations.test.js && node --test scripts/readiness.test.mjs scripts/e2e-runtime.test.mjs scripts/load.test.mjs scripts/load-transport.test.mjs",
    "test:integration": "tsc -p tsconfig.test.json && node --env-file=../../.env scripts/integration.mjs",
    "db:migrate": "node --env-file=../../.env dist/modules/database/migrate.js",
    "worker": "node --env-file=../../.env dist/worker.js",
    "admin:bootstrap": "node --env-file=../../.env dist/modules/auth/bootstrap-admin.js",
    "smoke:core": "node --env-file=../../.env scripts/core-smoke.mjs",
    "worker:search": "node --env-file=../../.env dist/search-worker.js",
    "test:e2e": "node --env-file=../../.env scripts/product-e2e.mjs",
    "worker:commerce": "node --env-file=../../.env dist/commerce-worker.js",
    "worker:professional": "node --env-file=../../.env dist/professional-worker.js",
    "worker:trust": "node --env-file=../../.env dist/trust-worker.js",
    "recovery:drill": "node --env-file=../../.env scripts/recovery-fixture.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@raui/config": "workspace:*",
    "@raui/types": "workspace:*",
    "csv-parse": "7.0.2",
    "express": "^5",
    "fast-xml-parser": "5.11.2",
    "helmet": "^8.1.0",
    "nodemailer": "10.0.16",
    "pg": "^8.16.3",
    "redis": "^5.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2",
    "@types/express": "^5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.15.5"
  }
}
