{
  "name": "raui-ru",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:web": "pnpm --filter @raui/web dev",
    "dev:api": "pnpm --filter @raui/api dev",
    "infra:up": "docker compose --env-file .env -f infra/compose.yaml up -d --wait",
    "infra:down": "docker compose --env-file .env -f infra/compose.yaml down",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && python3 -m unittest discover -s apps/ai/tests && node --test scripts/runtime-image.test.mjs",
    "build": "pnpm -r build",
    "smoke": "node scripts/smoke.mjs",
    "test:integration": "pnpm --filter @raui/api test:integration",
    "db:migrate": "pnpm --filter @raui/api db:migrate",
    "worker:media": "pnpm --filter @raui/api worker",
    "smoke:core": "pnpm --filter @raui/api smoke:core",
    "worker:search": "pnpm --filter @raui/api worker:search",
    "search:reindex": "pnpm --filter @raui/api worker:search --reindex --once",
    "search:reconcile": "pnpm --filter @raui/api worker:search --reconcile --once",
    "test:e2e": "pnpm --filter @raui/api test:e2e",
    "smoke:search": "node scripts/search-smoke.mjs",
    "worker:commerce": "pnpm --filter @raui/api worker:commerce",
    "worker:professional": "pnpm --filter @raui/api worker:professional",
    "worker:trust": "pnpm --filter @raui/api worker:trust",
    "security:check": "node scripts/security-check.mjs && pnpm audit --prod --audit-level moderate",
    "recovery:drill": "pnpm --filter @raui/api recovery:drill",
    "release:verify": "node scripts/release-contract.mjs verify",
    "observability:check": "node scripts/observability-check.mjs",
    "test:runtime": "node --test scripts/runtime-image.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "sharp",
      "esbuild"
    ]
  }
}
