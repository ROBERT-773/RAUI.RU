NODE_ENV=development
# Local Next production builds are not a production deployment.
# Set DEPLOYMENT_ENV=production on real production API and web runtimes.
DEPLOYMENT_ENV=local
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://raui:local-development-only@127.0.0.1:5432/raui
REDIS_URL=redis://127.0.0.1:6379
POSTGRES_USER=raui
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=raui

# Phase 2: local adapters; never use local delivery/storage in production
SESSION_DAYS=7
STORAGE_DRIVER=local
LOCAL_PRIVATE_DIR=.cache/private
# For S3: STORAGE_DRIVER=s3, S3_BUCKET and optional S3_ENDPOINT/S3_REGION.
# Supply AWS credentials through the standard SDK credential chain, never Git.
# CDN_BASE_URL is an optional API/CDN reverse-proxy base URL.
# VERIFICATION_GATEWAY_URL (HTTPS) and VERIFICATION_GATEWAY_TOKEN are required
# for real email/SMS delivery and production startup.
# GEOCODER_URL (HTTPS), GEOCODER_TOKEN are optional; manual coordinates work without them.

OPENSEARCH_URL=http://127.0.0.1:9200
OPENSEARCH_ALIAS=raui-listings
API_INTERNAL_URL=http://127.0.0.1:3001
SITE_URL=http://localhost:3000

# Optional raster provider; configure together with legally required attribution.
# NEXT_PUBLIC_MAP_TILE_URL=https://your-provider/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_ATTRIBUTION=Your provider attribution

# Phase 4B: exact public HTTPS hosts approved for feeds; empty denies fetch
FEED_ALLOWED_HOSTS=
# Optional delivery gateway; honors Idempotency-Key, credentials server-side
# NOTIFICATION_GATEWAY_URL=https://gateway.example/notifications
# NOTIFICATION_GATEWAY_TOKEN=

# Phase 4C: all AI paths are off until both this kill switch and the admin capability flag are on.
AI_ENABLED=false
AI_ALLOWED_HOSTS=
AI_CALL_CAP_MICROS=100000
AI_DAILY_BUDGET_MICROS=1000000
# Optional, server-side only. Gateway must enforce limits, deadlines and Idempotency-Key.
# AI_GATEWAY_URL=https://approved-ai-provider.example/generate
# AI_GATEWAY_TOKEN=<configure securely; never commit a real token>

# Production requires matching clean HTTPS WEB_ORIGIN/SITE_URL, rediss:// Redis,
# PostgreSQL sslmode=verify-full (trusted CA), authenticated HTTPS OpenSearch,
# private S3 storage and real verification delivery. Supply credentials securely.
# SITE_URL and DEPLOYMENT_ENV must also be bound during the web build/runtime.

# RC: production web/API share a server-only random PROXY_IDENTITY_SECRET (32+ characters).
# Generate/bind it securely; no real key belongs here. API trusts exact socket peer IPs:
# TRUSTED_PROXY_PEERS=127.0.0.1,::1
# TRUSTED_INGRESS_IP_HEADER=x-real-ip
# Production ingress MUST strip caller values, set its socket-derived client IP,
# and prevent direct public access to Next. This is not generic X-Forwarded-For trust.
# Bind API_INTERNAL_URL to the clean private HTTPS origin in production.

# Optional reset-only RU-CENTER SMTP; HTTPS verification gateway takes priority.
# Requires clean HTTPS WEB_ORIGIN. Inject password securely; never commit it.
RESET_SMTP_ENABLED=false
# RESET_SMTP_PASSWORD=

# Numeric phone verification is disabled until a controlled gateway is configured.
PHONE_OTP_ENABLED=false
# PHONE_OTP_PEPPER=  # independently generated >=32 random bytes, base64url
# PHONE_OTP_GATEWAY_URL=  # clean public HTTPS443 endpoint
# PHONE_OTP_GATEWAY_TOKEN=  # secure environment binding, never browser-side
